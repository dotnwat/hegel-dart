# Pub reads this *instead of* .gitignore, not in addition to it, so everything
# .gitignore keeps out of the repository has to be repeated here or a local
# build artefact ends up in the published archive.

# Generated and local artefacts, mirroring .gitignore.
build/
coverage/
doc/api/
native/
.hegel/
pubspec.lock

# The implementation plan and review notes are for people working on this
# package, not for people depending on it. Excluding docs/ also avoids pub
# asking for it to be renamed to doc/, which would break every reference to it.
docs/

# The Flutter example is a package of its own, with a path dependency back on
# this one. It cannot build from inside the published archive, and a consumer
# has no use for it; it lives in the repository.
example/flutter/
example/flutter_demo/

# Development-only tooling.
tool/
.pre-commit-config.yaml
.gitattributes

# Never shipped, for the same reason .gitignore excludes it.
lib/libhegel_docs.dart
